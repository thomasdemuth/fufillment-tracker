# Copy to .env. Everything is optional; defaults run the app fully offline with mock carriers.

# Where the SQLite database and uploaded files live (inside the container when using Docker).
DATA_DIR=./data

# Optional: protect the UI with a password (HTTP Basic, any username).
# APP_PASSWORD=change-me

# Optional: key used to encrypt carrier secrets at rest. Auto-generated into DATA_DIR/.secret_key if unset.
# APP_SECRET_KEY=

# mock  -> generate realistic fake tracking data (no credentials needed)
# live  -> call the real carrier APIs using credentials from the Settings page or the vars below
CARRIER_MODE=mock

# Optional: carrier credentials via env (override anything saved in the Settings page).
# USPS_CLIENT_ID=
# USPS_CLIENT_SECRET=
# FEDEX_API_KEY=
# FEDEX_SECRET_KEY=

# Map basemap style. Default is OpenFreeMap (public vector tiles). See README for offline PMTiles.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
